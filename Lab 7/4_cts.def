VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN k_lut_block ;
UNITS DISTANCE MICRONS 1000 ;
DIEAREA ( 0 0 ) ( 22380 22380 ) ;
ROW ROW_0 unithd 2300 2720 N DO 39 BY 1 STEP 460 0 ;
ROW ROW_1 unithd 2300 5440 FS DO 39 BY 1 STEP 460 0 ;
ROW ROW_2 unithd 2300 8160 N DO 39 BY 1 STEP 460 0 ;
ROW ROW_3 unithd 2300 10880 FS DO 39 BY 1 STEP 460 0 ;
ROW ROW_4 unithd 2300 13600 N DO 39 BY 1 STEP 460 0 ;
ROW ROW_5 unithd 2300 16320 FS DO 39 BY 1 STEP 460 0 ;
TRACKS X 230 DO 48 STEP 460 LAYER li1 ;
TRACKS Y 170 DO 66 STEP 340 LAYER li1 ;
TRACKS X 170 DO 66 STEP 340 LAYER met1 ;
TRACKS Y 170 DO 66 STEP 340 LAYER met1 ;
TRACKS X 230 DO 49 STEP 460 LAYER met2 ;
TRACKS Y 230 DO 49 STEP 460 LAYER met2 ;
TRACKS X 340 DO 33 STEP 680 LAYER met3 ;
TRACKS Y 340 DO 33 STEP 680 LAYER met3 ;
TRACKS X 460 DO 24 STEP 920 LAYER met4 ;
TRACKS Y 460 DO 24 STEP 920 LAYER met4 ;
TRACKS X 1700 DO 6 STEP 3400 LAYER met5 ;
TRACKS Y 1700 DO 6 STEP 3400 LAYER met5 ;
VIAS 3 ;
    - via2_3_480_480_1_1_320_320 + VIARULE M1M2_PR + CUTSIZE 150 150  + LAYERS met1 via met2  + CUTSPACING 170 170  + ENCLOSURE 85 165 55 85  ;
    - via3_4_480_480_1_1_400_400 + VIARULE M2M3_PR + CUTSIZE 200 200  + LAYERS met2 via2 met3  + CUTSPACING 200 200  + ENCLOSURE 40 85 65 65  ;
    - via4_5_480_480_1_1_400_400 + VIARULE M3M4_PR + CUTSIZE 200 200  + LAYERS met3 via3 met4  + CUTSPACING 200 200  + ENCLOSURE 90 60 140 65  ;
END VIAS
NONDEFAULTRULES 1 ;
    - CTS_NDR_0
      + LAYER li1 WIDTH 170 SPACING 340
      + LAYER met1 WIDTH 140 SPACING 280
      + LAYER met2 WIDTH 140 SPACING 280
      + LAYER met3 WIDTH 300 SPACING 600
      + LAYER met4 WIDTH 300 SPACING 600
      + LAYER met5 WIDTH 1600 SPACING 3200
    ;
END NONDEFAULTRULES
