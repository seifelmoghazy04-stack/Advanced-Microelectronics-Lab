VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN k_lut_block ;
UNITS DISTANCE MICRONS 1000 ;
DIEAREA ( 0 0 ) ( 22380 22380 ) ;
ROW ROW_0 unithd 2300 2720 N DO 39 BY 1 STEP 460 0 ;
ROW ROW_1 unithd 2300 5440 FS DO 39 BY 1 STEP 460 0 ;
ROW ROW_2 unithd 2300 8160 N DO 39 BY 1 STEP 460 0 ;
ROW ROW_3 unithd 2300 10880 FS DO 39 BY 1 STEP 460 0 ;
ROW ROW_4 unithd 2300 13600 N DO 39 BY 1 STEP 460 0 ;
ROW ROW_5 unithd 2300 16320 FS DO 39 BY 1 STEP 460 0 ;
TRACKS X 230 DO 48 STEP 460 LAYER li1 ;
TRACKS Y 170 DO 66 STEP 340 LAYER li1 ;
TRACKS X 170 DO 66 STEP 340 LAYER met1 ;
TRACKS Y 170 DO 66 STEP 340 LAYER met1 ;
TRACKS X 230 DO 49 STEP 460 LAYER met2 ;
TRACKS Y 230 DO 49 STEP 460 LAYER met2 ;
TRACKS X 340 DO 33 STEP 680 LAYER met3 ;
TRACKS Y 340 DO 33 STEP 680 LAYER met3 ;
TRACKS X 460 DO 24 STEP 920 LAYER met4 ;
TRACKS Y 460 DO 24 STEP 920 LAYER met4 ;
TRACKS X 1700 DO 6 STEP 3400 LAYER met5 ;
TRACKS Y 1700 DO 6 STEP 3400 LAYER met5 ;
COMPONENTS 8 ;
    - _2_ sky130_fd_sc_hd__mux4_2 ;
    - _3_ sky130_fd_sc_hd__and2_0 ;
    - _4_ sky130_fd_sc_hd__nor2b_1 ;
    - _5_ sky130_fd_sc_hd__dfxtp_1 ;
    - _6_ sky130_fd_sc_hd__dfxtp_1 ;
    - _7_ sky130_fd_sc_hd__dfxtp_1 ;
    - _8_ sky130_fd_sc_hd__dfxtp_1 ;
    - _9_ sky130_fd_sc_hd__dfxtp_1 ;
END COMPONENTS
PINS 10 ;
    - In_0 + NET In_0 + DIRECTION INPUT + USE SIGNAL ;
    - In_1 + NET In_1 + DIRECTION INPUT + USE SIGNAL ;
    - In_2 + NET In_2 + DIRECTION INPUT + USE SIGNAL ;
    - In_3 + NET In_3 + DIRECTION INPUT + USE SIGNAL ;
    - clk + NET clk + DIRECTION INPUT + USE SIGNAL ;
    - f_sel[0] + NET f_sel[0] + DIRECTION INPUT + USE SIGNAL ;
    - f_sel[1] + NET f_sel[1] + DIRECTION INPUT + USE SIGNAL ;
    - is_synced + NET is_synced + DIRECTION INPUT + USE SIGNAL ;
    - out + NET out + DIRECTION OUTPUT + USE SIGNAL ;
    - out_ff + NET dff_inst.q + DIRECTION OUTPUT + USE SIGNAL ;
END PINS
NETS 16 ;
    - In_0 ( PIN In_0 ) ( _9_ D ) + USE SIGNAL ;
    - In_1 ( PIN In_1 ) ( _5_ D ) + USE SIGNAL ;
    - In_2 ( PIN In_2 ) ( _6_ D ) + USE SIGNAL ;
    - In_3 ( PIN In_3 ) ( _7_ D ) + USE SIGNAL ;
    - _0_ ( _8_ D ) ( _3_ X ) + USE SIGNAL ;
    - _1_ ( _4_ B_N ) ( _3_ B ) ( _2_ X ) + USE SIGNAL ;
    - clk ( PIN clk ) ( _9_ CLK ) ( _8_ CLK ) ( _7_ CLK ) ( _6_ CLK ) ( _5_ CLK ) + USE SIGNAL ;
    - dff_inst.q ( PIN out_ff ) ( _8_ Q ) + USE SIGNAL ;
    - f_sel[0] ( PIN f_sel[0] ) ( _2_ S0 ) + USE SIGNAL ;
    - f_sel[1] ( PIN f_sel[1] ) ( _2_ S1 ) + USE SIGNAL ;
    - is_synced ( PIN is_synced ) ( _4_ A ) ( _3_ A ) + USE SIGNAL ;
    - out ( PIN out ) ( _4_ Y ) + USE SIGNAL ;
    - sr_inst.q[0] ( _9_ Q ) ( _2_ A0 ) + USE SIGNAL ;
    - sr_inst.q[1] ( _5_ Q ) ( _2_ A1 ) + USE SIGNAL ;
    - sr_inst.q[2] ( _6_ Q ) ( _2_ A2 ) + USE SIGNAL ;
    - sr_inst.q[3] ( _7_ Q ) ( _2_ A3 ) + USE SIGNAL ;
END NETS
END DESIGN
